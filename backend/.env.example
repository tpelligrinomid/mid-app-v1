# Supabase Configuration
# Note: We do NOT use the service role key - Lovable manages Supabase
# Privileged operations go through Edge Functions (which have service role internally)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Edge Function Authentication
# Shared secret between Render backend and Supabase Edge Functions
# Generate with: openssl rand -base64 32
# Must also be added to Supabase Edge Functions → Secrets
EDGE_FUNCTION_SECRET=your-generated-secret

# ClickUp Integration (API Token, not OAuth)
CLICKUP_API_TOKEN=your-clickup-api-token

# QuickBooks Integration (OAuth)
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=https://mid-app-v1.onrender.com/api/auth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production

# HubSpot Integration
HUBSPOT_API_KEY=your-hubspot-api-key

# Fireflies Integration (meeting transcripts)
FIREFLIES_API_KEY=your-fireflies-api-key

# Master Marketer Integration (AI meeting analysis)
MASTER_MARKETER_URL=https://your-master-marketer.onrender.com
MASTER_MARKETER_API_KEY=your-shared-api-key

# Server Configuration
PORT=3001

# Frontend URL (for CORS and OAuth redirects)
# Set this to your Lovable app URL
FRONTEND_URL=https://your-app.lovable.app

# Google Search Console — search visibility tracking
# The SAME credential Master Marketer uses. One shared MiD Google account that
# clients add as a user on their property; most existing contracts have already
# granted it. See docs/spec-search-visibility-tracking.md §4.4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GSC_REFRESH_TOKEN=
# Display only — the address shown to strategists for the client grant instructions
GSC_ACCOUNT_EMAIL=
